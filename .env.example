# ---- Database ----
POSTGRES_USER=agentreplay
POSTGRES_PASSWORD=agentreplay
POSTGRES_DB=agentreplay
DATABASE_URL=postgresql://agentreplay:agentreplay@localhost:5432/agentreplay

# ---- Queue ----
REDIS_URL=redis://localhost:6379/0

# ---- Object storage (local filesystem first; S3/R2 later) ----
STORAGE_BACKEND=filesystem
STORAGE_DIR=./storage
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ---- Web ----
VITE_API_URL=http://localhost:8000

# ---- DeepSeek (OpenAI-compatible): powers the LLM agent driver + AI summaries ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING=enabled
